<% const level=currentUser.is_admin ? 'admin' : currentUser.is_member ? 'member' : 'recruit' ; %>
    <%- include('partials/header', { title: 'Transmissions' }) %>

        <main class="feed">
            <div class="page-head">
                <h1 class="display">&gt; transmissions<span class="cursor"></span></h1>
            </div>

            <details class="composer" <%=errors.length ? 'open' : '' %>>
                <summary class="btn btn-outline">
                    <span class="label-closed">[+] NEW MESSAGE</span>
                    <span class="label-open">[-] CLOSE</span>
                </summary>

                <div class="terminal">
                    <div class="terminal-bar">
                        <span class="dot"></span><span class="dot"></span><span class="dot"></span>
                        <span class="terminal-title">
                            <%= currentUser.username %>@dev_clubhouse: ~/new_message
                        </span>
                    </div>

                    <form class="terminal-body" action="/messages" method="POST" novalidate>
                        <% if (errors.length) { %>
                            <ul class="errors" role="alert">
                                <% errors.forEach((err)=> { %>
                                    <li>&gt; ERROR: <%= err.msg %>
                                    </li>
                                    <% }) %>
                            </ul>
                            <% } %>

                                <div class="field">
                                    <label for="title">title</label>
                                    <input id="title" name="title" type="text" placeholder="What is this about?"
                                        value="<%= formData.title || '' %>" required>
                                </div>

                                <div class="field">
                                    <label for="text">message</label>
                                    <textarea id="text" name="text" rows="4" placeholder="Type your transmission..."
                                        required><%= formData.text || '' %></textarea>
                                </div>

                                <div class="form-foot">
                                    <span class="note">
                                        <%= level==='recruit' ? 'Your name and time stay classified for other recruits.'
                                            : 'Members see your name and time on this post.' %>
                                    </span>
                                    <button class="btn btn-solid" type="submit">&gt; TRANSMIT</button>
                                </div>
                    </form>
                </div>
            </details>

            <% if (level==='recruit' ) { %>
                <div class="banner banner-recruit">
                    <div>
                        <div class="banner-title">RESTRICTED FIELDS</div>
                        <div>Authors and timestamps are classified until you enter the secret key.</div>
                    </div>
                    <a class="btn btn-warn" href="/join">&gt; ./join --key</a>
                </div>
                <% } else if (level==='member' ) { %>
                    <div class="banner banner-member">
                        <div>
                            <div class="banner-title">IDENTITIES DECRYPTED</div>
                            <div>You can now see who wrote each transmission and when.</div>
                        </div>
                    </div>
                    <% } else { %>
                        <div class="banner banner-admin">
                            <div>
                                <div class="banner-title">ADMIN CONSOLE</div>
                                <div>You can see every identity and delete any transmission.</div>
                            </div>
                        </div>
                        <% } %>

                            <div class="messages">
                                <% messages.forEach((m)=> { %>
                                    <article class="message">
                                        <div class="meta">
                                            <span class="ref">
                                                <%= m.ref %>
                                            </span>
                                            <% if (m.handle) { %>
                                                <span class="handle">@<%= m.handle %></span>
                                                <span class="dim">
                                                    <%= m.name %>
                                                </span>
                                                <time class="time" datetime="<%= m.iso %>">
                                                    <%= m.time %>
                                                </time>
                                                <% } else { %>
                                                    <span class="redacted"
                                                        aria-label="Author classified">CLASSIFIED</span>
                                                    <span class="redacted"
                                                        aria-label="Timestamp redacted">REDACTED</span>
                                                    <% } %>
                                        </div>
                                        <h2>
                                            <%= m.title %>
                                        </h2>
                                        <p>
                                            <%= m.text %>
                                        </p>
                                    </article>
                                    <% }) %>
                            </div>
        </main>

        <%- include('partials/footer') %>